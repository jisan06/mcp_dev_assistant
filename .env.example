# Groq API Key for LLM Inference (Required)
GROQ_API_KEY=your_groq_api_key_here

# GitHub Personal Access Token (Required for GitHub MCP tools)
GITHUB_TOKEN=your_github_token_here

# Default Target Repository (Optional)
GITHUB_OWNER=your_github_username
GITHUB_REPO=your_repository_name

# Allowed Repositories Filter (Optional comma-separated list)
# GITHUB_ALLOWED_REPOS=owner/repo1,owner/repo2

# GitHub Write Operations Toggle (Optional: true/false, default: true)
GITHUB_ALLOW_WRITE=true

# Secret key for human approval HMAC tokens (Optional: generated automatically if omitted)
# APPROVAL_SECRET=your_custom_approval_secret_here
